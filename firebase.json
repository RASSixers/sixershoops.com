{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/article/**",
        "destination": "/article.html"
      },
      {
        "source": "/user/**",
        "destination": "/user-profile.html"
      },
      {
        "source": "/trade/**",
        "destination": "/trade.html"
      }
    ]
  }
}
